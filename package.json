{
  "name": "postgres-job-queue",
  "version": "0.1.0",
  "description": "A durable background-job queue built on PostgreSQL, Node.js and TypeScript.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node --env-file=.env --import tsx src/migrate-main.ts",
    "api": "node --env-file=.env --import tsx src/api-main.ts",
    "worker": "node --env-file=.env --import tsx src/worker-main.ts",
    "test": "vitest run",
    "bench": "node --env-file=.env --import tsx scripts/bench.ts",
    "demo:enqueue": "node --env-file=.env --import tsx scripts/enqueue.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
